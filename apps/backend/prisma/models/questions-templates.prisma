/// 재사용 가능한 필기 문제 원본입니다.
model QuestionBank {
  /// 기본 키입니다.
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 세부 과목 식별자입니다.
  subjectId    String          @map("subject_id") @db.Uuid
  /// 문제 유형입니다.
  type         QuestionType
  /// 문제 내용입니다.
  prompt       String          @db.Text
  /// 문제 해설입니다.
  explanation  String?         @db.Text
  /// 기본 배점입니다.
  defaultScore Decimal         @map("default_score") @db.Decimal(6, 2)
  /// 난이도입니다.
  difficulty   DifficultyLevel
  /// 출제 가능 여부입니다.
  active       Boolean
  /// 작성자 식별자입니다.
  createdById  String?         @map("created_by") @db.Uuid
  /// 생성 시각입니다.
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정 시각입니다.
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject           Subject                  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy         User?                    @relation("QuestionBankCreator", fields: [createdById], references: [id], onDelete: SetNull)
  options           QuestionOption[]
  acceptedAnswers   QuestionAcceptedAnswer[]
  templateQuestions ExamTemplateQuestion[]
  examQuestions     ExamQuestion[]           @relation("ExamQuestionSource")

  @@index([subjectId, type, difficulty, active])
  @@map("question_bank")
}

/// 문제은행의 객관식 보기입니다.
model QuestionOption {
  /// 기본 키입니다.
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 문제 식별자입니다.
  questionId   String  @map("question_id") @db.Uuid
  /// 보기 내용입니다.
  content      String  @db.Text
  /// 표시 순서입니다.
  displayOrder Int     @map("display_order")
  /// 정답 여부입니다.
  isCorrect    Boolean @map("is_correct")

  question QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, displayOrder])
  @@map("question_options")
}

/// 단답형 문제의 허용 정답입니다.
model QuestionAcceptedAnswer {
  /// 기본 키입니다.
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 문제 식별자입니다.
  questionId       String @map("question_id") @db.Uuid
  /// 표시용 정답입니다.
  answerText       String @map("answer_text") @db.Text
  /// 정규화된 정답입니다.
  normalizedAnswer String @map("normalized_answer") @db.Text
  /// 표시 순서입니다.
  displayOrder     Int    @map("display_order")

  question QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, normalizedAnswer])
  @@map("question_accepted_answers")
}

/// 반복 개설용 시험 템플릿입니다.
model ExamTemplate {
  /// 기본 키입니다.
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 템플릿 이름입니다.
  name            String    @db.VarChar(200)
  /// 템플릿 설명입니다.
  description     String?   @db.Text
  /// 시험 범위입니다.
  scope           ExamScope
  /// 시험 단계입니다.
  stage           ExamStage
  /// 기본 응시 기간 일수입니다.
  defaultOpenDays Int?      @map("default_open_days")
  /// 작성자 식별자입니다.
  createdById     String?   @map("created_by") @db.Uuid
  /// 생성 시각입니다.
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정 시각입니다.
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User?                 @relation("ExamTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  subjects  ExamTemplateSubject[]
  parts     ExamTemplatePart[]
  exams     Exam[]

  @@map("exam_templates")
}

/// 시험 템플릿에 포함된 과목입니다.
model ExamTemplateSubject {
  /// 시험 템플릿 식별자입니다.
  examTemplateId String @map("exam_template_id") @db.Uuid
  /// 세부 과목 식별자입니다.
  subjectId      String @map("subject_id") @db.Uuid

  examTemplate ExamTemplate @relation(fields: [examTemplateId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([examTemplateId, subjectId])
  @@map("exam_template_subjects")
}

/// 시험 템플릿의 필기 또는 실기 파트입니다.
model ExamTemplatePart {
  /// 기본 키입니다.
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 시험 템플릿 식별자입니다.
  examTemplateId        String       @map("exam_template_id") @db.Uuid
  /// 파트 유형입니다.
  type                  ExamPartType
  /// 필기 제한 시간입니다.
  durationMinutes       Int?         @map("duration_minutes")
  /// 전체 시험 시작일 기준 시작 차이입니다.
  defaultOpenOffsetDays Int          @map("default_open_offset_days")
  /// 기본 공개 일수입니다.
  defaultOpenDays       Int          @map("default_open_days")
  /// 최소 제출 파일 수입니다.
  minFiles              Int?         @map("min_files") @db.SmallInt
  /// 최대 제출 파일 수입니다.
  maxFiles              Int?         @map("max_files") @db.SmallInt
  /// 파일당 최대 크기입니다.
  maxFileSizeBytes      BigInt?      @map("max_file_size_bytes")
  /// 전체 최대 크기입니다.
  maxTotalSizeBytes     BigInt?      @map("max_total_size_bytes")
  /// 응시 안내입니다.
  instructions          String?      @db.Text

  examTemplate      ExamTemplate                     @relation(fields: [examTemplateId], references: [id], onDelete: Cascade)
  questions         ExamTemplateQuestion[]
  practicalCriteria ExamTemplatePracticalCriterion[]

  @@unique([examTemplateId, type])
  @@map("exam_template_parts")
}

/// 시험 템플릿에 선택된 필기 문제입니다.
model ExamTemplateQuestion {
  /// 기본 키입니다.
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 템플릿 파트 식별자입니다.
  examTemplatePartId String  @map("exam_template_part_id") @db.Uuid
  /// 문제은행 식별자입니다.
  questionId         String  @map("question_id") @db.Uuid
  /// 표시 순서입니다.
  displayOrder       Int     @map("display_order")

  examTemplatePart ExamTemplatePart @relation(fields: [examTemplatePartId], references: [id], onDelete: Cascade)
  question         QuestionBank     @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([examTemplatePartId, questionId])
  @@unique([examTemplatePartId, displayOrder])
  @@map("exam_template_questions")
}

/// 시험 템플릿의 실기 평가 기준입니다.
model ExamTemplatePracticalCriterion {
  /// 기본 키입니다.
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 템플릿 파트 식별자입니다.
  examTemplatePartId String  @map("exam_template_part_id") @db.Uuid
  /// 평가 항목명입니다.
  name               String  @db.VarChar(200)
  /// 평가 기준 설명입니다.
  description        String? @db.Text
  /// 항목 최대 점수입니다.
  maxScore           Decimal @map("max_score") @db.Decimal(6, 2)
  /// 표시 순서입니다.
  displayOrder       Int     @map("display_order")

  examTemplatePart ExamTemplatePart @relation(fields: [examTemplatePartId], references: [id], onDelete: Cascade)

  @@unique([examTemplatePartId, displayOrder])
  @@map("exam_template_practical_criteria")
}
