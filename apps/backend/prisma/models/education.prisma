/// EducationField 테이블입니다.
model EducationField {
  /// id 컬럼입니다.
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// name 컬럼입니다.
  name         String   @db.VarChar(100)
  /// description 컬럼입니다.
  description  String?  @db.Text
  /// displayOrder 컬럼입니다.
  displayOrder Int      @map("display_order")
  /// active 컬럼입니다.
  active       Boolean
  /// createdAt 컬럼입니다.
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// updatedAt 컬럼입니다.
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subjects               Subject[]
  primaryCourseOfferings CourseOffering[]

  @@unique([name], map: "uq_education_fields_name")
  @@map("education_fields")
}

/// Subject 테이블입니다.
model Subject {
  /// id 컬럼입니다.
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// educationFieldId 컬럼입니다.
  educationFieldId       String      @map("education_field_id") @db.Uuid
  /// name 컬럼입니다.
  name                   String      @db.VarChar(150)
  /// description 컬럼입니다.
  description            String?     @db.Text
  /// objective 컬럼입니다.
  objective              String?     @db.Text
  /// mode 컬럼입니다.
  mode                   SubjectMode
  /// defaultDurationMinutes 컬럼입니다.
  defaultDurationMinutes Int?        @map("default_duration_minutes")
  /// displayOrder 컬럼입니다.
  displayOrder           Int         @map("display_order")
  /// active 컬럼입니다.
  active                 Boolean
  /// createdAt 컬럼입니다.
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// updatedAt 컬럼입니다.
  updatedAt              DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  educationField         EducationField          @relation(fields: [educationFieldId], references: [id], onDelete: Restrict)
  courseOfferingSubjects CourseOfferingSubject[]
  questionBanks          QuestionBank[]
  examTemplateSubjects   ExamTemplateSubject[]

  @@unique([educationFieldId, name], map: "uq_subjects_field_name")
  @@index([educationFieldId, active, displayOrder], map: "idx_subjects_field_active_order")
  @@map("subjects")
}

/// CourseOffering 테이블입니다.
model CourseOffering {
  /// id 컬럼입니다.
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// name 컬럼입니다.
  name                    String       @db.VarChar(200)
  /// createdById 컬럼입니다.
  createdById             String?      @map("created_by") @db.Uuid
  /// createdAt 컬럼입니다.
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  /// updatedAt 컬럼입니다.
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 기본 교육 분야입니다.
  primaryEducationFieldId String       @map("primary_education_field_id") @db.Uuid
  /// 교육과정 담당 강사입니다.
  instructorId            String       @map("instructor_id") @db.Uuid
  /// 보관 시각입니다.
  archivedAt              DateTime?    @map("archived_at") @db.Timestamptz(6)

  primaryEducationField EducationField          @relation(fields: [primaryEducationFieldId], references: [id], onDelete: Restrict)
  instructor            User                    @relation("CourseOfferingInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  createdBy             User?                   @relation("CourseOfferingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  subjects              CourseOfferingSubject[]
  classPrograms         ClassProgram[]
  enrollments           Enrollment[]
  exams                 Exam[]
  examSubjects          ExamSubject[]
  examClassTargets      ExamClassTarget[]
  examAttempts          ExamAttempt[]

  @@index([archivedAt, name], map: "idx_course_offerings_archived_name")
  @@index([instructorId], map: "idx_course_offerings_instructor")
  @@map("course_offerings")
}

/// CourseOfferingSubject 테이블입니다.
model CourseOfferingSubject {
  /// id 컬럼입니다.
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// courseOfferingId 컬럼입니다.
  courseOfferingId String    @map("course_offering_id") @db.Uuid
  /// subjectId 컬럼입니다.
  subjectId        String    @map("subject_id") @db.Uuid
  /// createdAt 컬럼입니다.
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// updatedAt 컬럼입니다.
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  courseOffering      CourseOffering       @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  subject             Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classSubjects       ClassSubject[]
  classSessions       ClassSession[]
  enrollmentSubjects  EnrollmentSubject[]
  sessionParticipants SessionParticipant[]
  attendanceRecords   AttendanceRecord[]
  examSubjects        ExamSubject[]
  examQuestions       ExamQuestion[]

  @@unique([courseOfferingId, subjectId], map: "uq_course_offering_subjects_subject")
  @@unique([id, courseOfferingId], map: "uq_course_offering_subjects_id_offering")
  @@map("course_offering_subjects")
}
