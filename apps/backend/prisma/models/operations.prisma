/// 주요 업무 데이터 변경 감사 로그입니다.
model AuditLog {
  /// 기본 키입니다.
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 작업자 식별자입니다.
  actorId      String?     @map("actor_id") @db.Uuid
  /// 작업 당시 역할입니다.
  actorRole    UserRole?   @map("actor_role")
  /// 작업 종류입니다.
  action       String      @db.VarChar(100)
  /// 대상 자원 종류입니다.
  resourceType String      @map("resource_type") @db.VarChar(100)
  /// 대상 자원 식별자입니다.
  resourceId   String?     @map("resource_id") @db.VarChar(100)
  /// 변경 전 데이터입니다.
  beforeData   Json?       @map("before_data") @db.JsonB
  /// 변경 후 데이터입니다.
  afterData    Json?       @map("after_data") @db.JsonB
  /// 변경 사유입니다.
  reason       String?     @db.Text
  /// 요청 IP 주소입니다.
  ipAddress    String?     @map("ip_address") @db.Inet
  /// 요청 브라우저 정보입니다.
  userAgent    String?     @map("user_agent") @db.Text
  /// 요청 추적 식별자입니다.
  requestId    String?     @map("request_id") @db.Uuid
  /// 처리 결과입니다.
  result       AuditResult
  /// 실패 업무 오류 코드입니다.
  errorCode    String?     @map("error_code") @db.VarChar(100)
  /// 작업 시각입니다.
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("audit_logs")
}

/// 서버 오류와 운영 이벤트 로그입니다.
model SystemLog {
  /// 기본 키입니다.
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 로그 수준입니다.
  level     String   @db.VarChar(20)
  /// 로그 메시지입니다.
  message   String   @db.Text
  /// 오류 코드입니다.
  errorCode String?  @map("error_code") @db.VarChar(100)
  /// 내부 스택 정보입니다.
  stack     String?  @db.Text
  /// 관련 사용자입니다.
  userId    String?  @map("user_id") @db.Uuid
  /// API 경로입니다.
  route     String?  @db.VarChar(300)
  /// 요청 추적 식별자입니다.
  requestId String?  @map("request_id") @db.Uuid
  /// 민감정보를 제외한 추가 정보입니다.
  metadata  Json?    @db.JsonB
  /// 발생 시각입니다.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation("SystemLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([level, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("system_logs")
}

/// 데이터베이스 백업 실행 결과입니다.
model BackupRun {
  /// 기본 키입니다.
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 백업 시작 시각입니다.
  startedAt         DateTime  @map("started_at") @db.Timestamptz(6)
  /// 백업 종료 시각입니다.
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(6)
  /// 백업 상태입니다.
  status            String    @db.VarChar(30)
  /// 외부 저장 위치입니다.
  storageKey        String?   @map("storage_key") @db.VarChar(500)
  /// 백업 파일 크기입니다.
  sizeBytes         BigInt?   @map("size_bytes")
  /// 백업 체크섬입니다.
  checksum          String?   @db.VarChar(128)
  /// 보관 종료 시각입니다.
  retentionUntil    DateTime? @map("retention_until") @db.Timestamptz(6)
  /// 실패 메시지입니다.
  errorMessage      String?   @map("error_message") @db.Text
  /// 복구 시험 시각입니다.
  restoreTestedAt   DateTime? @map("restore_tested_at") @db.Timestamptz(6)
  /// 복구 시험 결과입니다.
  restoreTestResult String?   @map("restore_test_result") @db.VarChar(30)

  @@map("backup_runs")
}

/// 데이터 생명주기 배치 실행 결과입니다.
model DataLifecycleRun {
  /// 기본 키입니다.
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 배치 작업 종류입니다.
  jobType      String    @map("job_type") @db.VarChar(50)
  /// 실행 시작 시각입니다.
  startedAt    DateTime  @map("started_at") @db.Timestamptz(6)
  /// 실행 종료 시각입니다.
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  /// 실행 상태입니다.
  status       String    @db.VarChar(30)
  /// 확인한 대상 수입니다.
  scannedCount Int       @default(0) @map("scanned_count")
  /// 성공 처리 수입니다.
  successCount Int       @default(0) @map("success_count")
  /// 실패 처리 수입니다.
  failureCount Int       @default(0) @map("failure_count")
  /// 재개용 마지막 커서입니다.
  lastCursor   String?   @map("last_cursor") @db.VarChar(200)
  /// 민감정보를 제외한 오류 요약입니다.
  errorSummary String?   @map("error_summary") @db.Text
  /// 생성 시각입니다.
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([jobType, startedAt(sort: Desc)])
  @@index([status, startedAt])
  @@map("data_lifecycle_runs")
}

/// 운영 중 조정 가능한 시스템 정책값입니다.
model SystemSetting {
  /// 설정 키입니다.
  key         String   @id @db.VarChar(100)
  /// JSON 설정값입니다.
  value       Json     @db.JsonB
  /// 설정 설명입니다.
  description String?  @db.Text
  /// 마지막 수정자입니다.
  updatedById String?  @map("updated_by") @db.Uuid
  /// 수정 시각입니다.
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation("SystemSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}
